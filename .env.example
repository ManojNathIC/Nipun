GEMINI_API_KEY=your_gemini_api_key_here
GITHUB_TOKEN=your_github_token_here

# PostHog - used to store and retrieve previous PR reviews for comparison
# Get these from your PostHog project settings
POSTHOG_API_KEY=your_posthog_project_api_key
POSTHOG_PERSONAL_API_KEY=your_posthog_personal_api_key
POSTHOG_PROJECT_ID=your_posthog_project_id
# Change to https://eu.i.posthog.com if you're on the EU cloud
POSTHOG_HOST=https://us.i.posthog.com
AI_DISPLAY_NAME=Nipun

# Minimum severity level to include in the PR comment posted to GitHub.
# The full review in the sidepanel always shows ALL severity levels.
# This setting only filters what gets posted as a comment on GitHub.
# Options: critical | major | medium | minor | suggestion
# Example: If set to 'medium', then critical, major, and medium issues are posted.
MIN_SEVERITY_TO_BLOCK=minor

# Whether to automatically post the AI review summary as a PR comment.
# Options: true | false
# Default: true
POST_REVIEW_COMMENT=true
